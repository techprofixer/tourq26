// Torq Studio — Prisma + MongoDB Atlas
// Set DATABASE_URL=mongodb+srv://.../YOUR_DB_NAME?retryWrites=true&w=majority
// Push schema: npx prisma db push  (MongoDB: removed models leave their old collections in place — drop them manually if wanted)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Torq Studio CMS (marketing site) — MongoDB collections
// =============================================================================

// Enums
// ─────────────────────────────────────────────

/// Drives the default URL prefix (see pathFor in src/lib/cms/pages.ts) and the JSON-LD type a
/// page emits. Values not offered in the editor are kept so existing documents still deserialize.
enum PageType {
  HOME
  SERVICE
  SOLUTION
  INDUSTRY
  TECHNOLOGY
  LOCATION
  PRICING
  CASE_STUDY
  BLOG
  GUIDE
  COMPARISON
  GLOSSARY
  WHITEPAPER
  TEMPLATE
  RESEARCH
  NEWS
  COMPANY
  CONTACT
  LANDING
  PROGRAMMATIC
  CUSTOM
}

enum WorkflowStatus {
  DRAFT
  SEO_REVIEW
  ENGINEERING_REVIEW
  EDITORIAL_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum EntityKind {
  SERVICE
  SOLUTION
  INDUSTRY
  TECHNOLOGY
  LOCATION
  AUTHOR
  CLIENT
  CATEGORY
  TAG
  PRICING_PLAN
  FAQ
  GLOSSARY_TERM
}

enum RedirectType {
  PERMANENT_301
  TEMPORARY_302
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  OTHER
}

enum BuyerStage {
  AWARENESS
  CONSIDERATION
  DECISION
  RETENTION
}

enum SearchIntent {
  INFORMATIONAL
  NAVIGATIONAL
  COMMERCIAL
  TRANSACTIONAL
}

// ─────────────────────────────────────────────
// Core Page + SEO + Brief
// ─────────────────────────────────────────────

model Page {
  id                String         @id @default(cuid()) @map("_id")
  slug              String
  path              String         @unique
  title             String
  type              PageType
  status            WorkflowStatus @default(DRAFT)
  locale            String         @default("en")
  excerpt           String?
  primaryEntityKind EntityKind?
  primaryEntityId   String?
  publishedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  /// Ordered block instances — validated with Zod in src/lib/cms/blocks.ts
  blocks Json @default("[]")

  seo            SeoMetadata?
  brief          ContentBrief?
  workflowEvents WorkflowEvent[]

  @@index([status, publishedAt])
  @@index([type, status])
  @@index([primaryEntityKind, primaryEntityId])
  @@index([locale, status])
}

model SeoMetadata {
  id                 String   @id @default(cuid()) @map("_id")
  pageId             String   @unique
  metaTitle          String?
  metaDescription    String?
  /// Absolute URL; set only when this page duplicates another. Pages canonicalised elsewhere are
  /// left out of the sitemap, llms.txt and IndexNow pings.
  canonical          String?
  robotsIndex        Boolean  @default(true)
  robotsFollow       Boolean  @default(true)
  ogTitle            String?
  ogDescription      String?
  /// Social / OG share image (1200×630). Also used as the JSON-LD primaryImageOfPage.
  ogImageUrl         String?
  twitterTitle       String?
  twitterDescription String?
  /// Optional raw JSON-LD object or array, appended after the auto-generated graph.
  jsonLdCustom       Json?
  breadcrumbLabel    String?
  focusKeyword       String?
  /// Named author for E-E-A-T (Article schema `author`). Falls back to the organisation.
  authorName         String?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model ContentBrief {
  id                String        @id @default(cuid()) @map("_id")
  pageId            String        @unique
  targetKeyword     String?
  secondaryKeywords String[]      @default([])
  searchIntent      SearchIntent?
  targetAudience    String?
  buyerStage        BuyerStage?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model WorkflowEvent {
  id         String         @id @default(cuid()) @map("_id")
  pageId     String
  fromStatus WorkflowStatus
  toStatus   WorkflowStatus
  actorId    String?
  comment    String?
  createdAt  DateTime       @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@index([toStatus, createdAt])
}

// ─────────────────────────────────────────────
// Entities
// ─────────────────────────────────────────────

// Service/Solution/Industry/Technology are a deliberately unified taxonomy shape — same fields,
// same optional category/parentId, so admin CMS forms and CmsEntityPage/makeHubPage can treat all
// four generically. Keep new fields added to one of these mirrored across all four.
model Service {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  name        String
  summary     String?
  description String?
  icon        String?
  category    String?
  parentId    String?
  sortOrder   Int      @default(0)
  pageId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([parentId])
}

model Solution {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  name        String
  summary     String?
  description String?
  icon        String?
  category    String?
  parentId    String?
  sortOrder   Int      @default(0)
  pageId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([parentId])
}

model Industry {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  name        String
  summary     String?
  description String?
  icon        String?
  category    String?
  parentId    String?
  sortOrder   Int      @default(0)
  pageId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([parentId])
}

model Location {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  name        String
  summary     String?
  description String?
  icon        String?
  category    String?
  parentId    String?
  sortOrder   Int      @default(0)
  pageId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([parentId])
}

model Technology {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  name        String
  summary     String?
  description String?
  icon        String?
  category    String?
  parentId    String?
  sortOrder   Int      @default(0)
  pageId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

