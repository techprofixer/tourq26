// ─────────────────────────────────────────────
// Authors / Clients / Testimonials / Case Studies
// ─────────────────────────────────────────────

model Testimonial {
  id        String   @id @default(cuid()) @map("_id")
  quote     String
  result    String?
  name      String
  role      String?
  company   String?
  rating    Int      @default(5)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// Pricing / FAQ / Comparison helpers
// ─────────────────────────────────────────────

model PricingPlan {
  id         String   @id @default(cuid()) @map("_id")
  slug       String   @unique
  name       String
  summary    String?
  priceLabel String?
  currency   String?
  features   Json?
  ctaLabel   String?
  ctaHref    String?
  pageId     String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Faq {
  id         String      @id @default(cuid()) @map("_id")
  question   String
  answer     String
  entityKind EntityKind?
  entityId   String?
  pageId     String?
  sortOrder  Int         @default(0)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([entityKind, entityId])
}

// ─────────────────────────────────────────────
// Media / Navigation / Redirects
// ─────────────────────────────────────────────

model MediaAsset {
  id          String    @id @default(cuid()) @map("_id")
  kind        MediaKind @default(IMAGE)
  url         String
  cdnKey      String?
  filename    String
  mimeType    String?
  width       Int?
  height      Int?
  sizeBytes   Int?
  alt         String?
  title       String?
  blurDataUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([kind, createdAt])
}

model Navigation {
  id        String   @id @default(cuid()) @map("_id")
  key       String   @unique
  label     String
  locale    String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MenuItem[]
}

model MenuItem {
  id           String  @id @default(cuid()) @map("_id")
  navigationId String
  parentId     String?
  label        String
  href         String?
  pageId       String?
  sortOrder    Int     @default(0)
  openInNewTab Boolean @default(false)
  metadata     Json?

  navigation Navigation @relation(fields: [navigationId], references: [id], onDelete: Cascade)

  @@index([navigationId, sortOrder])
}

model Footer {
  id        String   @id @default(cuid()) @map("_id")
  key       String   @unique @default("default")
  blurb     String?
  tagline   String?
  columns   Json
  legal     Json?
  socials   Json?
  updatedAt DateTime @updatedAt
}

model Redirect {
  id        String       @id @default(cuid()) @map("_id")
  fromPath  String       @unique
  toPath    String
  type      RedirectType @default(PERMANENT_301)
  isActive  Boolean      @default(true)
  note      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model SiteSettings {
  id                 String   @id @default(cuid()) @map("_id")
  key                String   @unique @default("default")
  siteUrl            String?
  siteName           String   @default("Torq Studio")
  defaultTitle       String?
  defaultDescription String?
  titleTemplate      String?
  keywords           String[] @default([])
  ogTitle            String?
  ogDescription      String?
  twitterHandle      String?
  twitterTitle       String?
  twitterDescription String?
  socialProfiles     String[] @default([])
  /// Free-form Markdown appended to /llms.txt (positioning notes, preferred citations, etc.).
  llmsTxtExtra       String?
  featureFlags       Json?
  googleSiteVerification String?
  bingSiteVerification   String?
  robotsNoIndex          Boolean  @default(false)
  /// When true, robots.txt blocks AI *training* crawlers (GPTBot, CCBot, Google-Extended, …)
  /// while still allowing AI *search/answer* crawlers that cite and link back.
  blockAiTraining        Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model BlogPost {
  id           String   @id @default(cuid()) @map("_id")
  slug         String   @unique
  title        String
  seoTitle     String?
  description  String
  excerpt      String?
  date         String
  dateUpdated  String?
  readTime     String
  body         String
  authorName   String?
  status       String   @default("published")
  coverImage   String?
  coverAlt     String?
  coverTitle   String?
  tags         String[] @default([])
  focusKeyword String?
  wordCount    Int?
  /// Optional content blocks rendered after the body — validated with Zod in src/lib/cms/blocks.ts
  blocks       Json?
}

